<?xml version="1.0"?>
<!--
  The `id` below is a PLACEHOLDER. Connect IQ generates a real one when the
  project is created in the SDK ("New Project") or when the app is registered
  in the Connect IQ store, and the iOS side needs the same value to address
  the app. Do not invent one by hand.

  The product list is the devices we claim to support. The SDK Manager's
  device list is authoritative; these are current watches that carry the
  accelerometer, the optical heart sensor and enough memory. minApiLevel 3.2
  is set by `registerSensorDataListener` (2.3) and the sport constants.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="EightZeroEightApp"
        id="00000000000000000000000000000000"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="watch-app">

        <!--
          A device can only be targeted if it is BOTH listed here and
          installed in the SDK Manager. This list is the set installed on
          Aziz's Mac on 2026-09-18 that also clears minApiLevel, so every
          entry actually builds. The Forerunners (fr265, fr965), Venu and
          Instinct belong in the store list and are NOT here yet: tick them
          in SDK Manager > Devices first, then add them.
        -->
        <iq:products>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix947mm"/>
            <iq:product id="fenix9pro47mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="vivoactive4"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="Fit"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
