<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest (required since 2024 for required-reason APIs).

  Accessed APIs: UserDefaults only, reason CA92.1 (the app reading its own
  preferences: migration flags, AppStorage-backed setup choices).

  Collected data: PRODUCT INTERACTION only, for analytics, since 2026-08-17
  (PostHog, behavioral events: screens completed, sessions started and
  finished, paywall and purchase funnel, feature usage). Not linked to
  identity: the ID is an anonymous install-scoped UUID. NSPrivacyTracking
  stays FALSE because nothing is used for cross-app tracking or advertising.

  What is deliberately NOT collected, and must never appear here: health and
  fitness data. Heart rate, breathing, stillness, scores, and every value
  derived from them stay on device (HealthKit data may not be disclosed to
  third parties, guideline 5.1.3). Health results never leave the device;
  the account/session log syncs only to the user's own PRIVATE CloudKit
  database, which we cannot read.

  The App Privacy labels in App Store Connect must match this file. As of
  2026-09-01 that is THREE types, all Analytics, none linked, none tracking:
  Product Interaction, User ID, and Purchases.

  User ID is declared because the analytics SDK generates a persistent
  install-scoped UUID (a random UUID v7 in its own storage, never the IDFA or
  identifierForVendor) and transmits it with every event as the distinct_id.
  It is anonymous, which is why it is NOT linked, but it is collected.

  Purchases is declared because the monetization events name the plan bought
  (purchase, trial started, restore, entitlement lost). No payment details ever
  touch this path, so Financial Info stays off.

  Email Address is declared since 2026-09-14 (ships in the build after
  1.0.1): the no-Watch waitlist screen sends the address the person types,
  and only when they tap Join, to our own Google Sheet so we can write to them
  when a session works without a Watch. It IS linked (an email identifies
  the person by definition), purpose Developer's Advertising or Marketing,
  not tracking. The App Privacy labels must add it at that submission.

  Friends (1.1, 2026-09-18) adds FOUR more, and these are different in kind
  from the analytics above: they are things the person writes and we can
  read. Posts, profiles and photos go to the PUBLIC CloudKit database of our
  own container, which the developer can read, so by Apple's definition they
  are collected. All four are LINKED (a profile is the person) and none are
  tracking:

    - Photos or Videos: the selfie on a post, and the profile photo.
    - Other User Content: the post's title and description, and the reason
      text on a report.
    - Name: the display name on a profile.
    - User ID: the @username, which is chosen and public. (The analytics
      entry above is also User ID but anonymous and unlinked; the label in
      App Store Connect must be the stronger of the two, linked.)

  What Friends does NOT put in the public database, and must never: heart
  rate, breathing, stillness, a curve, or any reading behind the score. A
  post carries only the free share card's fields (score, minutes, streak,
  technique). 5.1.3 still binds, and `test_postCarriesOnlyTheFreeCardFields`
  is the guard.

  The private CloudKit database (account, sessions, streak) is still the
  user's own and still not collected: we cannot read it.

  Change the manifest and the labels together, always.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
