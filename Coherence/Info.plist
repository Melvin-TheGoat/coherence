<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>808</string>
	<!-- Documents visible in the Files app: motion-capture CSVs from the
	     posture-free breathing / tremor experiments land in Documents and get
	     pulled off the phone by AirDrop or devicectl. Harmless in release:
	     Documents only ever holds these captures. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>808</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>808 uses heart data recorded on your Apple Watch to measure how your body settled after a session.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>808 records a mindful workout on your Apple Watch so it can capture your heartbeat during a session.</string>
	<!-- NSCameraUsageDescription removed 2026-08-11. It described the
	     fingertip-PPG coherence check, which was cut in the MVP; no camera code
	     remains anywhere in the app. Declaring a permission for a feature that
	     does not exist makes a false statement to the user, forces a camera
	     answer in the App Privacy labels, and contradicts the privacy policy's
	     "we do not collect camera data". If the camera path ever returns (it
	     lives on the full-feature-set branch), put the string back with it. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>808 saves your share card to your photo library so you can post it to your Instagram story.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<!-- Export compliance, answered once here instead of on every upload.
	     US export rules make App Store Connect ask whether the app uses
	     encryption. 808 uses only HTTPS through the system frameworks, which is
	     exempt, and ships no cryptography of its own. Revisit if that ever
	     stops being true. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
