<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>808</string>
	<!-- Documents visible in the Files app: motion-capture CSVs from the
	     posture-free breathing / tremor experiments land in Documents and get
	     pulled off the phone by AirDrop or devicectl. Harmless in release:
	     Documents only ever holds these captures. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Baloo2-600.ttf</string>
		<string>Baloo2-700.ttf</string>
		<string>Baloo2-800.ttf</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>808</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>808 reads the heart rate your Apple Watch measures during a session you start, to show you how your body settled.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>808 saves each measured session to Apple Health as a Mind and Body workout and as mindful minutes.</string>
	<!-- Camera, as 1.1 ships (2026-09-29): two uses, both started by the
	     person. The Friends profile photo (CreateProfileView, CameraPicker)
	     and a photo for a session's own page (SaveSessionView, SelfieCamera).
	     Posting to friends is gone, so the "selfie you post" wording went
	     with it. Otto's video call screen (Block, FaceTimeCamera) also opens
	     the front camera, but Block is off in 1.1: when blockInRelease flips,
	     name that screen here again ("and to show you on Otto's video call
	     screen; nothing from it is recorded or saved"). A permission string
	     for a feature the build does not show is a false statement, which is
	     why the camera string was removed on 2026-08-11 and must stay true to
	     the build. App Privacy labels: Photos or Videos (profile photo). -->
	<key>NSCameraUsageDescription</key>
	<string>808 uses the camera when you choose to take a photo, for your Friends profile picture or for a session's page.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>808 saves your share card to your photo library so you can post it to your Instagram story.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
		<string>shortcuts</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lockout.meditate808</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>coherence808</string>
			</array>
		</dict>
	</array>
	<key>NSFocusStatusUsageDescription</key>
	<string>808 checks whether a Focus is already on so the switch on the session screen tells you the truth about your phone.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<!-- Export compliance, answered once here instead of on every upload.
	     US export rules make App Store Connect ask whether the app uses
	     encryption. 808 uses only HTTPS through the system frameworks, which is
	     exempt, and ships no cryptography of its own. Revisit if that ever
	     stops being true. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
